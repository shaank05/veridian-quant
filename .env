UPSTOX_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJrZXlfaWQiOiJza192MS4wIiwiYWxnIjoiSFMyNTYifQ.eyJzdWIiOiIxMjUyODQiLCJqdGkiOiI2YTExZDFjZGFlOTQwYzYwZGE5ZjQ4N2IiLCJpc011bHRpQ2xpZW50IjpmYWxzZSwiaXNQbHVzUGxhbiI6ZmFsc2UsImlhdCI6MTc3OTU1MjcxNywiaXNzIjoidWRhcGktZ2F0ZXdheS1zZXJ2aWNlIiwiZXhwIjoxNzc5NTczNjAwfQ.p4gGLGUok2wYHg48Vp92kellcDO2R_i8PZMR07iz42w

# =====================================================================
# INGESTION DATA BOUNDS
# =====================================================================
DATA_INGESTION_MODE=WATCHLIST # Options: 'WATCHLIST' (uses your 25 stocks for dev) or 'FULL' (queries DB for everything)

# The 'Safety Net' lookback
# 0 = Fully Automatic (calculates the gap from the last DB timestamp)
# >0 = Manual Override (forces the script to fetch X days regardless of DB state)
HISTORICAL_LOOKBACK_DAYS=2360 


# Default period for the very first run (Initial Load)
# Used only if the stock has 0 records in the prices_ohlc table.
INITIAL_LOAD_DAYS=30

# =====================================================================
# STRATEGY REGISTRY MATRIX (PARALLEL VOTING CONFIGURATION Matrix)
# Note: These values run concurrently inside equity_scanner.py.
# Restrictions act as strict execution vetoes ONLY when running live PROD.
# =====================================================================

# --- 1. CORE MEAN REVERSION (BASE LINE SETTING) ---
NODE_Z_SCORE_ENABLED=true
NODE_Z_SCORE_LOOKBACK=20

# --- 2. MACRO & TREND REGIME OVERLAYS ---
NODE_MACRO_REGIME_ENABLED=true
NODE_NIFTY_SMA_PRIMARY=50
NODE_NIFTY_SMA_SECONDARY=20
NODE_INDIA_VIX_LOOKBACK=20

# --- 3. STAGE 2.1: SHANNON INFORMATION ENTROPY NOISE SHIELD ---
NODE_SHANNON_ENTROPY_ENABLED=true
NODE_SHANNON_ENTROPY_LOOKBACK=20
NODE_SHANNON_ENTROPY_MAX_THRESHOLD=0.75

# --- 4. TIMING ANALYSIS: FFT CYCLE PHASE ---
NODE_FFT_TIMING_ENABLED=true
NODE_FFT_LOOKBACK_WINDOW=64

# --- 5. ORDER FLOW ANALYSIS: VOLUME SPREAD ANALYSIS (VSA) ---
NODE_VSA_VALIDATION_ENABLED=true
NODE_VSA_VOLUME_SMA=20

# --- 6. POINT-IN-TIME MARKOV REGIME FILTER ---
NODE_MARKOV_CASCADE_ENABLED=true
NODE_MARKOV_LOOKBACK_DAYS=90
NODE_MARKOV_MAX_PERSISTENCE=0.60

# --- 7. STAGE 2.2: CONTINUOUS WAVELET TRANSFORM UPGRADE ---
NODE_CWT_ANALYSIS_ENABLED=false
NODE_CWT_SCALES_RANGE=32

# --- 8. STAGE 4: STOCHASTIC PATH PREDICTION ENGINE (MONTE CARLO) ---
NODE_MONTE_CARLO_ENABLED=false
NODE_MC_SIMULATION_COUNT=10000
NODE_MC_TARGET_PROBABILITY_HURDLE=0.65

# --- 9. STAGE 5: THE ENSEMBLE BAYESIAN INFRASTRUCTURE ---
NODE_BAYESIAN_MASTER_ENABLED=false
NODE_BAYESIAN_CONVICTION_THRESHOLD=75.0

# =====================================================================
# COMBINATION ENFORCEMENT POLICY (USED BY PRODUCTION ENGINE ONLY)
# =====================================================================
# Options: 
# 1. STRICT_CONSENSUS   - Every enabled boolean voting node must pass.
# 2. ENSEMBLE_THRESHOLD - Relies 100% on Stage 5 Bayesian Master Controller.
# 3. CORE_VETO          - Requires Z-Score + VSA; all other metrics appended as metadata.
PRODUCTION_COMBINATION_MODE=STRICT_CONSENSUS