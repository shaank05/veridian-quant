# =====================================================================
# SYSTEM & DATABASE CONFIGURATION
# =====================================================================
ENV=DEV
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=medallion_fund
DB_USER=postgres
DB_PASSWORD=new_password

# SQLALCHEMY CONNECTION STRING
DATABASE_URL=postgresql+psycopg2://postgres:new_password@127.0.0.1:5433/medallion_fund 

MARKET_MODE=INDIA
ACTIVE_DATA_PROVIDER=UPSTOX

# =====================================================================
# UPSTOX MARKET DATA API CREDENTIALS
# =====================================================================
UPSTOX_INSTRUMENT_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_API_VERSION=2.0

UPSTOX_API_KEY=a85728da-4e56-46be-a456-7349e28e37cc
UPSTOX_API_SECRET=h0u4hseg1y
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback

MAX_PAGINATION_DAYS_1M=30
MAX_PAGINATION_DAYS_1D=365

# For Data Ingestion Script Engine 
DATA_INGEST_BACKFILL_START_DATE=2020-01-01
DATA_INGEST_SLEEP_WINDOW=0.25

# =====================================================================
# STAGE 2.1: PARALLEL ENSEMBLE SIGNAL PROCESSING ENGINE VARS
# =====================================================================

# --- 1. CORE EXECUTION TOGGLES ---
NODE_Z_SCORE_ENABLED=True
NODE_FFT_ENABLED=True
NODE_ENTROPY_ENABLED=True
NODE_CWT_ENABLED=True
NODE_MARKOV_ENABLED=True

# --- 2. MATHEMATICAL ARCHITECTURE MODEL BOUNDARIES ---
# Threshold rule for checking deep mean-reversion entries
NODE_Z_SCORE_THRESHOLD=-1.5

# Max permitted Shannon Chaos Level (Set to 2.1 to loosen/match core calculations)
NODE_ENTROPY_MAX_THRESHOLD=2.1

# --- 3. LIVE PRODUCTION SCHEDULER & POLICY ACTIONS ---
# Active policy filter modes: 'CONVICTION_THRESHOLD', 'STRICT_CONSENSUS', or 'BYPASS'
PRODUCTION_POLICY_MODE=CONVICTION_THRESHOLD

# The required percentage metric score for a parallel voting node consensus match
PRODUCTION_MIN_CONVICTION_SCORE=60.0

# Capital baseline pool mapping reference for live allocations (₹1 Crore)
PRODUCTION_INITIAL_EQUITY=10000000.0

# =====================================================================
# PRE-EXISTING ORIGINAL PIPELINE THRESHOLDS (BACKWARDS COMPATIBILITY)
# =====================================================================
NODE_Z_SCORE_CORE_ENABLED=true
NODE_Z_SCORE_LOOKBACK=20
NODE_Z_SCORE_ENTRY_LEVEL=-2.0
NODE_Z_SCORE_EXIT_LEVEL=0.5

# --- ENTROPY NOISE SHIELD ---
NODE_SHANNON_ENTROPY_ENABLED=true
NODE_SHANNON_ENTROPY_LOOKBACK=20

# --- TIMING ANALYSIS: FFT CYCLE PHASE ---
NODE_FFT_TIMING_ENABLED=true
NODE_FFT_LOOKBACK_WINDOW=64

# --- ORDER FLOW ANALYSIS: VOLUME SPREAD ANALYSIS (VSA) ---
NODE_VSA_VALIDATION_ENABLED=true
NODE_VSA_VOLUME_SMA=20

# --- POINT-IN-TIME MARKOV REGIME FILTER ---
NODE_MARKOV_CASCADE_ENABLED=true
NODE_MARKOV_LOOKBACK_DAYS=90
NODE_MARKOV_MAX_PERSISTENCE=0.60

# --- CONTINUOUS WAVELET TRANSFORM UPGRADE ---
NODE_CWT_ANALYSIS_ENABLED=true
NODE_CWT_SCALES_RANGE=32
NODE_CWT_ACTIVATION_THRESHOLD=1.90

# --- STAGE 4: STOCHASTIC PATH PREDICTION ENGINE (MONTE CARLO) ---
NODE_MONTE_CARLO_ENABLED=false
NODE_MC_SIMULATION_COUNT=10000
NODE_MC_TARGET_PROBABILITY_HURDLE=0.65