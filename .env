ENV=DEV

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=medallion_fund
DB_USER=postgres
DB_PASSWORD=new_password

# SQLALCHEMY CONNECTION STRING
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:new_password@127.0.0.1:5433/medallion_fund 

MARKET_MODE=INDIA  # Options: INDIA, CRYPTO, GLOBAL

ACTIVE_DATA_PROVIDER=UPSTOX
# Future options: NSE, ZERODHA, YAHOO

# UPSTOX DETAILS
# Generic details
UPSTOX_INSTRUMENT_URL = https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
UPSTOX_BASE_URL = https://api.upstox.com/v2
UPSTOX_API_VERSION = 2.0

# Upstox App Credentials
UPSTOX_API_KEY=a85728da-4e56-46be-a456-7349e28e37cc
UPSTOX_API_SECRET=h0u4hseg1y
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback

MAX_PAGINATION_DAYS_1M=30
MAX_PAGINATION_DAYS_1D=365

# For Data Ingestion (Long-lived 1-year token)
# UPSTOX_ANALYTICS_TOKEN= 

# For Trading (Short-lived, updated daily)
UPSTOX_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJrZXlfaWQiOiJza192MS4wIiwiYWxnIjoiSFMyNTYifQ.eyJzdWIiOiIxMjUyODQiLCJqdGkiOiI2YTExZDFjZGFlOTQwYzYwZGE5ZjQ4N2IiLCJpc011bHRpQ2xpZW50IjpmYWxzZSwiaXNQbHVzUGxhbiI6ZmFsc2UsImlhdCI6MTc3OTU1MjcxNywiaXNzIjoidWRhcGktZ2F0ZXdheS1zZXJ2aWNlIiwiZXhwIjoxNzc5NTczNjAwfQ.p4gGLGUok2wYHg48Vp92kellcDO2R_i8PZMR07iz42w

# Controls the scope of price ingestion
# Options: 'WATCHLIST' (uses your 25 stocks for dev) or 'FULL' (queries DB for everything)
DATA_INGESTION_MODE=WATCHLIST

# The 'Safety Net' lookback
# 0 = Fully Automatic (calculates the gap from the last DB timestamp)
# >0 = Manual Override (forces the script to fetch X days regardless of DB state)
HISTORICAL_LOOKBACK_DAYS=2360

# Default period for the very first run (Initial Load)
# Used only if the stock has 0 records in the prices_ohlc table.
INITIAL_LOAD_DAYS=30

# =====================================================================
# MARKOV REGIME FILTER CONFIGURATION
# =====================================================================
# Master switch to turn the Markov chain filter core layer ON or OFF
MARKOV_FILTER_ENABLED=true

# Fixed lookback window (in trading sessions) to build the 3x3 matrix
MARKOV_LOOKBACK_DAYS=90

# The minimum required probability (as a decimal) to transition from Crater to Equilibrium
MARKOV_MIN_PROBABILITY_THRESHOLD=0.35